{
  "name": "taparide-video",
  "private": true,
  "version": "1.0.0",
  "description": "Tap A Ride commercial and pitch film (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "music": "node scripts/music.mjs",
    "render:ad": "remotion render TapARideAd out/TapARide-Ad-16x9.mp4",
    "render:ad-vertical": "remotion render TapARideAdVertical out/TapARide-Ad-9x16.mp4",
    "render:pitch": "remotion render TapARidePitch out/TapARide-Pitch.mp4",
    "render:all": "npm run render:ad && npm run render:ad-vertical && npm run render:pitch"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.537",
    "@remotion/fonts": "^4.0.537",
    "@remotion/three": "^4.0.537",
    "@remotion/transitions": "^4.0.537",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537",
    "three": "^0.186.1"
  }
}
