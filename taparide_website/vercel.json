{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/waitlist.js": { "maxDuration": 10 },
    "api/assistant.js": { "maxDuration": 60 },
    "api/verify-documents.js": { "maxDuration": 60 },
    "api/insights.js": { "maxDuration": 60 },
    "api/geocode.js": { "maxDuration": 15 },
    "api/tiles.js": { "maxDuration": 10 },
    "api/pay.js": { "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.taparide.com" }], "destination": "https://taparide.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "dashboard.taparide.com" }], "destination": "https://taparide.com/dashboard/", "permanent": false },
    { "source": "/:path*", "has": [{ "type": "host", "value": "app.taparide.com" }], "destination": "https://taparide.com/app/", "permanent": false },
    { "source": "/login", "destination": "/app/#/login", "permanent": false },
    { "source": "/signup", "destination": "/app/#/register", "permanent": false },
    { "source": "/register", "destination": "/app/#/register", "permanent": false },
    { "source": "/partners/apply", "destination": "/dashboard/#/partner/apply", "permanent": false },
    { "source": "/admin", "destination": "/dashboard/", "permanent": false },
    { "source": "/r/:code", "destination": "/?ref=:code#join", "permanent": false },
    { "source": "/tech-week", "destination": "/#tech-week", "permanent": false },
    { "source": "/events", "destination": "/#tech-week", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/findme/:path*", "destination": "https://findme-ai-lozen-s-projects.vercel.app/api/:path*" },
    { "source": "/api/tiles/:z/:x/:f", "destination": "/api/tiles?z=:z&x=:x&f=:f" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/((?!app|dashboard|api).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(app|dashboard)/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(self \"https://findme-ai-lozen-s-projects.vercel.app\"), camera=(self), microphone=(self \"https://findme-ai-lozen-s-projects.vercel.app\")" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/(img|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
